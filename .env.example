# Runtime connection — MUST use the restricted application role (RLS enforced, no BYPASSRLS).
DATABASE_URL=postgres://officehub_app:change_me_app_password@localhost:5432/officehub

# Owner/migration connection — used only by `npm run db:migrate` and `npm run db:seed`. Never exposed to the app runtime.
DATABASE_OWNER_URL=postgres://officehub_owner:owner_pw@localhost:5432/officehub

# Password the migration script assigns to the officehub_app login role (must match DATABASE_URL).
DATABASE_APP_PASSWORD=change_me_app_password

# Shared secret for the scheduled reminders endpoint (GET /api/cron/reminders with "Authorization: Bearer <secret>").
CRON_SECRET=generate_a_long_random_string

# Set to "false" when serving over plain http locally; defaults to secure cookies in production.
# SESSION_COOKIE_SECURE=false

# Used only by `npm run db:seed` for the demo accounts (optional).
# SEED_PASSWORD=Password123!
